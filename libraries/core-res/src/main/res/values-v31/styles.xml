    <style name="SplashTheme" parent="Theme.Timer">
        <item name="android:windowBackground">#FF010101</item>
        <item name="android:statusBarColor">#FF010101</item>
        <item name="android:navigationBarColor">#FF010101</item>
        <item name="android:windowSplashScreenBackground">#FF010101</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
